<!-- MainWindow.xaml -->
<Window x:Class="Assignment3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sprite Sheet Generator" Height="520" Width="920"
        WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True" Margin="12">

        <!-- Top Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New"  Name="miNew"  Click="MiNew_Click"/>
                <MenuItem Header="_Open" Name="miOpen" Click="MiOpen_Click"/>
                <Separator/>
                <MenuItem Header="_Save" Name="miSave" Click="MiSave_Click" IsEnabled="False"/>
                <MenuItem Header="Save _As" Name="miSaveAs" Click="MiSaveAs_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Name="miExit" Click="MiExit_Click"/>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <Grid Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <!-- <name of project>.xml -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="SpriteSheet.xml"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                       Name="tbProjectXml"
                       Text="(not saved yet)"
                       Opacity="0.75"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>

            <!-- Output Directory -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Output Directory"
                       VerticalAlignment="Center"
                       Margin="0,10,0,0"/>

            <!-- REQUIRED NAME: tbOutputDir -->
            <TextBox Grid.Row="1" Grid.Column="1"
                     Name="tbOutputDir"
                     Margin="0,10,8,0"
                     MinHeight="28"/>

            <Button Grid.Row="1" Grid.Column="2"
                    Name="btnBrowse"
                    Content="Browse..."
                    Margin="0,10,0,0"
                    MinHeight="28"
                    Click="BtnBrowse_Click"/>

            <!-- Filename (.png) -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="Filename (.png)"
                       VerticalAlignment="Center"
                       Margin="0,10,0,0"/>

            <!-- REQUIRED NAME: tbOutputFile -->
            <TextBox Grid.Row="2" Grid.Column="1"
                     Name="tbOutputFile"
                     Margin="0,10,8,0"
                     MinHeight="28"/>

            <!-- metadata checkbox -->
            <CheckBox Grid.Row="2" Grid.Column="2"
                      Name="cbIncludeMetaData"
                      Content="Include meta data (.json)"
                      Margin="0,10,0,0"
                      VerticalAlignment="Center"/>

            <!-- Columns -->
            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="Columns"
                       VerticalAlignment="Center"
                       Margin="0,10,0,0"/>

            <!-- REQUIRED NAME: tbColumns -->
            <TextBox Grid.Row="3" Grid.Column="1"
                     Name="tbColumns"
                     Margin="0,10,8,0"
                     MinHeight="28"
                     Width="120"
                     HorizontalAlignment="Left"/>

            <!-- (Optional) ProgressBar placeholder -->
            <ProgressBar Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                         Name="pbProgress"
                         Height="16"
                         Margin="0,10,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Visibility="Collapsed"/>

            <!-- Images List (Horizontal) -->
            <GroupBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                      Header="Images"
                      Margin="0,10,0,0">
                <DockPanel>

                    <!-- Right side buttons -->
                    <StackPanel DockPanel.Dock="Right" Width="120" Margin="10,0,0,0">
                        <Button Name="btnAdd"
                                Content="Add"
                                MinHeight="28"
                                Margin="0,0,0,8"
                                Click="BtnAdd_Click"/>
                        <Button Name="btnRemove"
                                Content="Remove"
                                MinHeight="28"
                                Margin="0,0,0,8"
                                Click="BtnRemove_Click"/>
                        <Button Name="btnGenerate"
                                Content="Generate"
                                MinHeight="34"
                                Click="BtnGenerate_Click"/>
                    </StackPanel>

                    <!-- Horizontal ListBox -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ListBox Name="lbImages"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 SelectionMode="Single">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <!-- Item template: thumbnail + filename -->
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1"
                                            BorderBrush="#33000000"
                                            CornerRadius="6"
                                            Padding="8"
                                            Margin="0,0,10,0">
                                        <StackPanel Width="160">
                                            <Image Height="90"
                                                   Stretch="UniformToFill"
                                                   Margin="0,0,0,6"
                                                   Source="{Binding Thumbnail}"/>

                                            <TextBlock Text="{Binding FileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Opacity="0.85"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>

            <!-- Bottom status line -->
            <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                       Name="txtStatus"
                       Text="Ready."
                       Margin="0,10,0,0"
                       Opacity="0.8"/>
        </Grid>
    </DockPanel>
</Window>